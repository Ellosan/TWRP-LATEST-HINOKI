# MT6757 recovery init fragment for hinoki.
#
# init imports /init.recovery.${ro.hardware}.rc, and ro.hardware is "mt6757"
# on this board.
#
# Deliberately minimal: the stock fragment forced the android_usb gadget into
# MTP-only mode at "on init", which races TWRP's own USB setup and kills adb.
# TWRP configures /sys/class/android_usb/android0 itself from its init.rc, so
# all we do here is the MediaTek charger-mode plumbing.

on init
    # MTK USB charger detection. cmode 2 pins the port as CDP so the phone
    # keeps charging and enumerating while sitting in recovery.
    write /sys/devices/platform/mt_usb/cmode 2

on property:ro.debuggable=1
    # Debuggable builds need normal (SDP) enumeration for adb to come up.
    write /sys/devices/platform/mt_usb/cmode 1

on boot
    # Backlight is driven through the generic LED class node.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    # Vibrator used for TWRP haptics.
    chown system system /sys/class/timed_output/vibrator/enable
    chmod 0664 /sys/class/timed_output/vibrator/enable
