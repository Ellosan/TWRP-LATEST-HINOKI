# Recovery fstab for the Sony Xperia XA1 (hinoki), MT6757.
#
# Lines starting with /dev/ are parsed as TWRP fstab v2:
#   <block device>  <mount point>  <fs type>  <mount options>  <fs_mgr + TWRP flags>
# In v2 the flag column is comma separated and has no "flags=" prefix.
#
# Lines starting with a plain mount point are TWRP fstab v1:
#   <mount point>  <fs type>  <block device>  [alt block device]  flags=a;b;c
#
# Partition names come from the stock fstab.mt6757 and the stock ueventd
# by-name list. Note that hinoki flashes recovery to the "recovery" partition
# -- unlike Sony's Qualcomm devices it has no FOTAKernel partition.

# Core filesystems
# LineageOS 17.1 is system-as-root, so the system partition mounts at
# /system_root and TWRP presents /system from inside it.
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system    /system_root    ext4    ro,barrier=1                                                wait,display="System",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system    /system_image   emmc    defaults                                                    display="System Image",backup=0,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata  /data           ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                 wait,check,resize,encryptable=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/metadata
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache     /cache          ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                 wait,check,display="Cache",backup=1,wipeingui

# Vendor data partitions
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1  /protect_f      ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,display="Protect_f",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2  /protect_s      ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,display="Protect_s",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    /nvdata         ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                 wait,check,formattable,display="NVData",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvcfg     /nvcfg          ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,display="NVCfg",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/persist   /persist        ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc    wait,check,formattable,display="Persist",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/oem       /oem            ext4    ro                                                          wait,display="OEM",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/apps_log  /rca            ext4    nosuid,nodev,noatime,noexec,barrier=0,discard                wait,check,formattable,display="Apps Log",backup=0
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/diag      /idd            ext4    nosuid,nodev,noatime,noexec,barrier=0,discard                wait,check,formattable,display="Diag",backup=0

# Boot / recovery images
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot       /boot          emmc    defaults    display="Boot",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery   /recovery      emmc    defaults    display="Recovery",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk         /bootloader    emmc    defaults    display="LK",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk2        /bootloader2   emmc    defaults    display="LK2",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo       /logo          emmc    defaults    display="Logo",backup=1,flashimg=1

# Modem
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1img     /md1img        emmc    defaults    display="MD1 Image",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1dsp     /md1dsp        emmc    defaults    display="MD1 DSP",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1arm7    /md1arm7       emmc    defaults    display="MD1 ARM7",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md3img     /md3img        emmc    defaults    display="MD3 Image",backup=1,flashimg=1

# TEE / security
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee1       /tee1          emmc    defaults    display="TEE",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee2       /tee2          emmc    defaults    backup=1,subpartitionof=/tee1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro      /secro         emmc    defaults    display="Secro",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/seccfg     /seccfg        emmc    defaults    display="Seccfg",backup=0
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo    /proinfo       emmc    defaults    display="Proinfo",backup=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram      /nvram         emmc    defaults    display="NVRAM",backup=1,flashimg=1
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/otp        /otp           emmc    defaults    display="OTP",backup=0

# Misc / bookkeeping
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para       /misc          emmc    defaults    display="Misc",backup=0
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp        /persistent    emmc    defaults    display="FRP",backup=0
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/expdb      /expdb         emmc    defaults    display="Expdb",backup=0
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot_para  /boot_para     emmc    defaults    display="Boot Para",backup=0

# Removable storage (v1 format so the whole-disk fallback device can be given)
/external_sd    auto    /dev/block/mmcblk1p1    /dev/block/mmcblk1    flags=display="MicroSD";storage;wipeingui;removable;backup=0
/usb_otg        auto    /dev/block/sda1         /dev/block/sda        flags=display="USB OTG";storage;wipeingui;removable;backup=0
